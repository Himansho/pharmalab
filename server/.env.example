# PharmaLab server configuration — copy to "server/.env" and fill in.
# WITHOUT a key, all deterministic features (drug search, labels, interactions,
# PubMed) work; AI features (summaries, chart analysis, case coach) show a
# setup notice instead of failing.

# Cavoti (OpenAI-compatible) — used for Qwen3.8-Flash agent features
CAVOTI_API_KEY=
LLM_BASE_URL=https://cavoti.com/v1
LLM_MODEL=qwen-3.8-flash
LLM_VISION_MODEL=qwen-3.8-flash

# Optional NCBI API key raises PubMed E-utilities rate limit 3 -> 10 req/s
NCBI_API_KEY=

# Optional openFDA key (raises rate limit) — app works without it
OPENFDA_API_KEY=

PORT=8787
