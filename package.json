{
  "name": "pharmalab",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaLab – Drug Mechanism & Safety Explorer (educational)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node server/index.mjs\" \"vite\"",
    "server": "node server/index.mjs",
    "web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.0"
  }
}
